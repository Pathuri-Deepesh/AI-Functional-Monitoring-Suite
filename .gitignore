# Dependencies
node_modules/

# Build outputs
dist/
build/
.vite/
*.tsbuildinfo
# Phase 1.27.10 — backend/public/ holds the copied frontend build for the
# single-server bundle. Re-generated by `npm run build` at the repo root.
backend/public/

# Environment files
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# SQLite temp files (WAL mode auto-generates these)
backend/data/db.sqlite-shm
backend/data/db.sqlite-wal
backend/data/*.tmp

# Generated audit reports (regenerated on demand)
backend/data/reports/*.html

# User-uploaded binary files (per-project, never commit)
backend/data/uploads/

# Legacy migration backups
backend/data/*.bak
backend/data/*.migrated.bak
backend/data/urls.json

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# Editor files
.vscode/
.idea/
*.swp
*.swo

# Claude Code local cache (keep .mcp.json — project-level config)
.claude/cache/

# SQLite databases — never commit (contain API keys, captured tokens, churn every check)
backend/data/db.sqlite
backend/data/*.sqlite
backend/data/*.sqlite-shm
backend/data/*.sqlite-wal

# Local smoke-test scratch (curl -o run3.json etc.) — never commit
run*.json

# Postman CLI scaffolding (local-only, not part of the suite)
.postman/
postman/

# Internal tracker artifacts + helper scripts (kept local — excluded from GitLab push)
.claude_internal/
documentation/project-tracker.xlsx
documentation/project-tracker.csv
documentation/PROGRESS.md
.mcp.json

# Legacy root-level tracker leftovers (file was moved to documentation/ but Excel may still hold an open handle at root)
/project-tracker.xlsx
/~$project-tracker.xlsx

# Elastic Beanstalk Files
.elasticbeanstalk/*
!.elasticbeanstalk/*.cfg.yml
!.elasticbeanstalk/*.global.yml

# CDK generated output — synthesized CloudFormation + cached context lookups.
# Regenerated by `cdk synth`; not source. Excluded from the (public) repo because
# they embed the AWS account ID, VPC/subnet IDs, and IAM role ARNs.
infrastructure/cdk.out/
infrastructure/cdk.context.json
infrastructure/node_modules/

# Phase 1.25 — Email notifications via SMTP
#
# Copy this file to `.env` in the backend/ folder, then fill in real values.
# `.env` is gitignored — never commit real credentials.
#
# Gmail SMTP setup (demo / single-developer):
#   1. Enable 2-Step Verification on the Google account.
#   2. Generate a 16-char App Password at https://myaccount.google.com/apppasswords
#   3. Paste it as SMTP_PASS below (Gmail rejects the regular account password).
#
# Swap to Logitech / corporate SMTP later by changing the same four vars —
# no code change needed.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=deepesh500000@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM="Monitoring Suite <deepesh500000@gmail.com>"
